# 1단계: 빌드 (Node.js 환경)
FROM node:18-alpine AS build-stage
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build

# 2단계: 실행 (Nginx 환경 - 아주 가벼움)
FROM nginx:stable-alpine
# 빌드된 파일만 Nginx로 복사
COPY --from=build-stage /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]